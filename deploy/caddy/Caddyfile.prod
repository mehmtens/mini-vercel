# ==============================================================================
# Doplo Production Caddyfile (HTTPS + On-Demand TLS + Gateway)
# ==============================================================================
{
	email {$ACME_EMAIL:admin@doplo.app}
	on_demand_tls {
		ask http://api:8080/api/tls/ask
	}
}

# ------------------------------------------------------------------------------
# 1. Main Management Dashboard & API
# ------------------------------------------------------------------------------
{$APP_DOMAIN:app.doplo.app} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Fastify REST API & Webhooks
	handle /api/* {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /health* {
		reverse_proxy api:8080
	}

	handle /ready* {
		reverse_proxy api:8080
	}

	# Next.js Management Frontend Dashboard
	handle /* {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

# ------------------------------------------------------------------------------
# 2. Dynamic Preview & Project Domains (On-Demand TLS with Ask validation)
# Resolves immutable static assets through Fastify Artifact Gateway
# ------------------------------------------------------------------------------
:443 {
	tls {
		on_demand
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle {
		reverse_proxy api:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}
