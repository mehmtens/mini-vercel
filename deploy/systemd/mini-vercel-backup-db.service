[Unit]
Description=Mini-Vercel PostgreSQL Automated Backup Job
After=network.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mini-vercel
EnvironmentFile=-/opt/mini-vercel/.env
ExecStart=/bin/bash /opt/mini-vercel/scripts/backup-db.sh
StandardOutput=journal
StandardError=journal
User=root
