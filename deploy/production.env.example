# ==============================================================================
# Doplo Production Environment Variables Template
# ==============================================================================
# Copy this template to .env on production servers.
# Fill in real, securely generated credentials.
# POSTGRES_PASSWORD and REDIS_PASSWORD must use URL-safe characters only:
# letters, digits, dot, underscore, tilde, and hyphen.
# ==============================================================================

NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Domains & Routing
# ------------------------------------------------------------------------------
BASE_DOMAIN=doplo.dev
APP_DOMAIN=doplo.dev
ACME_EMAIL=admin@doplo.dev
# On the Linux host, run: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# ------------------------------------------------------------------------------
# 2. Database Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=doplo_prod_user
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=doplo

# ------------------------------------------------------------------------------
# 3. Redis Cache & Queue
# ------------------------------------------------------------------------------
REDIS_PASSWORD=generate_a_strong_redis_password_here

# ------------------------------------------------------------------------------
# 4. S3 / MinIO Object Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=generate_a_strong_minio_root_password_here
MINIO_BUCKET_BUILDS=doplo-builds

# ------------------------------------------------------------------------------
# 5. Security Keys (Strictly required in production)
# ------------------------------------------------------------------------------
# CRYPTO_MASTER_KEY must be a 64-character hex string (32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_MASTER_KEY=generate_64_hex_chars_master_key_here

# SESSION_SECRET must be at least 32 characters
SESSION_SECRET=generate_at_least_32_characters_random_secret_here

# ------------------------------------------------------------------------------
# 6. GitHub Integration
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_production_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_production_github_oauth_client_secret
GITHUB_CALLBACK_URL=https://doplo.dev/api/auth/callback/github
GITHUB_WEBHOOK_SECRET=generate_strong_webhook_secret_here

# ------------------------------------------------------------------------------
# 7. Queue & Performance Settings
# ------------------------------------------------------------------------------
QUEUE_NAME=deployment-queue
QUEUE_CONCURRENCY=5
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW=1 minute
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
