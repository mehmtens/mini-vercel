  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Platform Health & Service Dependencies",
      "type": "row"
    },
    {
      "id": 1,
      "title": "PostgreSQL Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "doplo_dependency_up_gauge{dependency=\"postgres\"}", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 2,
      "title": "Redis Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [{ "expr": "doplo_dependency_up_gauge{dependency=\"redis\"}", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 3,
      "title": "MinIO Storage Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "doplo_dependency_up_gauge{dependency=\"minio\"}", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 4,
      "title": "Active Build Jobs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "doplo_worker_active_jobs_gauge or doplo_active_deployments_gauge", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 5,
      "title": "Waiting Queue Jobs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "doplo_queue_waiting_jobs_gauge", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "API Traffic & Latency",
      "type": "row"
    },
    {
      "id": 6,
      "title": "HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (status_code)", "legendFormat": "Status {{status_code}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "API Response Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50 (Median)", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "Build Pipeline & Artifact Delivery",
      "type": "row"
    },
    {
      "id": 8,
      "title": "Build Execution Duration (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(doplo_build_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50 Build Time", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(doplo_build_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Build Time", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "title": "Queue Wait Duration",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(doplo_queue_wait_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Queue Wait", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "title": "S3 Artifact Fetch Latency",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(doplo_artifact_fetch_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Artifact Fetch", "refId": "A" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["doplo", "production", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Doplo System Overview",
  "version": 1
}
