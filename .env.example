# ==============================================================================
# Doplo — Monorepo Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' for local development.
# Do NOT commit real production credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Runtime Environment
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'test' | 'production'
NODE_ENV=development

# Base domain and management dashboard domain
BASE_DOMAIN=localhost
APP_DOMAIN=app.localhost
ACME_EMAIL=admin@doplo.local

# Base URL of the Frontend Next.js Web Dashboard
# Format: URL with protocol and port (no trailing slash)
APP_URL=http://localhost:3000

# Fastify API Server Settings
API_PORT=8081
API_HOST=0.0.0.0
API_URL=http://localhost:8081

# Next.js Web Dashboard Settings
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_BASE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local Docker Compose maps container 5432 to host port 5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doplo
POSTGRES_PORT=5435
POSTGRES_HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5435/doplo

# ------------------------------------------------------------------------------
# 3. Redis Connection (BullMQ Queue & Pub/Sub Log Streaming)
# ------------------------------------------------------------------------------
# Format: redis://[:password@]host:port
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380

# BullMQ Queue Engine Settings
QUEUE_NAME=deployment-queue
QUEUE_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 4. MinIO / S3-Compatible Object Storage
# ------------------------------------------------------------------------------
# MINIO_ENDPOINT: Hostname or IP without protocol (e.g., 'localhost' or 'minio')
# MINIO_PORT: API port (default: 9000, Console: 9001)
# MINIO_USE_SSL: 'true' for HTTPS, 'false' for HTTP
# MINIO_BUCKET_BUILDS: Target S3 bucket name for deployment build artifacts
# MINIO_REGION: AWS S3 compatible region identifier (default: 'us-east-1')
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BUILDS=doplo-builds
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# 5. Security, Cryptography & Rate Limiting
# ------------------------------------------------------------------------------
# CRYPTO_MASTER_KEY:
# - Purpose: Master key used for AES-256-GCM authenticated encryption of project environment variables.
# - Required Format: Exact 64 hexadecimal characters (representing 32 raw bytes / 256 bits).
# - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Example (64 hex characters): 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRYPTO_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SESSION_SECRET:
# - Purpose: Cryptographic salt/key for cookie session signing and JWT issuance.
# - Format: Minimum 32-character random string.
SESSION_SECRET=super_secret_session_signing_key_32_chars_min

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://app.localhost

# Rate Limiting & Protection Limits
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW=1 minute
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. GitHub OAuth & Webhook Integration
# ------------------------------------------------------------------------------
# GITHUB_CLIENT_ID: Client ID from GitHub OAuth App settings
GITHUB_CLIENT_ID=your_github_oauth_client_id

# GITHUB_CLIENT_SECRET: Client Secret from GitHub OAuth App settings
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GITHUB_CALLBACK_URL: OAuth authorization callback URL configured in GitHub App
GITHUB_CALLBACK_URL=http://localhost:8081/api/auth/callback/github

# Optional Google OAuth. Leave both values empty to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8081/api/auth/google/callback

# GITHUB_WEBHOOK_SECRET:
# - Purpose: Secret string configured in repository Webhooks for HMAC-SHA256 signature verification ('x-hub-signature-256').
# - Format: Random string matching GitHub Webhook settings.
GITHUB_WEBHOOK_SECRET=dev_webhook_secret_key_12345

# DEV_AUTH_BYPASS:
# - Purpose: Allows bypassing GitHub OAuth in local development by auto-provisioning a demo user.
# - Format: 'true' | 'false' (Set to 'false' in production)
DEV_AUTH_BYPASS=true

# ------------------------------------------------------------------------------
# 7. Caddy Dynamic Reverse Proxy
# ------------------------------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
