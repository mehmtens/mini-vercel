{
  "name": "@mini-vercel/worker",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mini-vercel/config": "workspace:*",
    "@mini-vercel/crypto": "workspace:*",
    "@mini-vercel/database": "workspace:*",
    "@mini-vercel/types": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.26.0",
    "bullmq": "^5.14.0",
    "dockerode": "^4.0.2",
    "ioredis": "^5.4.1",
    "minio": "^8.0.2",
    "prom-client": "^15.1.3",
    "tar-fs": "^3.0.6",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^20.17.0",
    "@types/tar-fs": "^2.0.4",
    "@types/tar-stream": "^3.1.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
